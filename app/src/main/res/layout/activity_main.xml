<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kp_bg"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Unified Top Bar: App Icon & Name on Right (Start in RTL), Gold Crown Button on Left (End in RTL) -->
        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="18dp"
            android:paddingTop="12dp"
            android:paddingBottom="10dp">

            <ImageView
                android:id="@+id/iv_app_logo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/app_name"
                android:src="@mipmap/ic_launcher_round" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/kp_text_primary"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_top_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_subtitle"
                    android:textColor="@color/kp_primary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Gold Crown Pro Button on Left -->
            <LinearLayout
                android:id="@+id/btn_pro_crown"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_crown_button"
                android:clickable="true"
                android:contentDescription="@string/pro_crown_desc"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/pro_crown_desc"
                    android:src="@drawable/ic_crown" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/pro_badge"
                    android:textColor="@color/kp_gold"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Fragment Host -->
        <FrameLayout
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- Floating Translucent Bottom Navigation Bar (3 Tabs ONLY) -->
    <LinearLayout
        android:id="@+id/floating_bottom_nav_wrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:id="@+id/floating_bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_floating_nav"
            android:elevation="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <!-- Tab 1: Home -->
            <LinearLayout
                android:id="@+id/nav_tab_home"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_nav_active_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/nav_icon_home"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/nav_home"
                    android:src="@drawable/ic_home" />

                <TextView
                    android:id="@+id/nav_label_home"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/nav_home"
                    android:textColor="@color/kp_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Tab 2: Settings -->
            <LinearLayout
                android:id="@+id/nav_tab_settings"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/nav_icon_settings"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/nav_settings"
                    android:src="@drawable/ic_settings" />

                <TextView
                    android:id="@+id/nav_label_settings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/nav_settings"
                    android:textColor="@color/kp_text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Tab 3: Requests -->
            <LinearLayout
                android:id="@+id/nav_tab_requests"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/nav_icon_requests"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/nav_requests"
                    android:src="@drawable/ic_requests" />

                <TextView
                    android:id="@+id/nav_label_requests"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/nav_requests"
                    android:textColor="@color/kp_text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Optional Animated Splash Screen Overlay -->
    <LinearLayout
        android:id="@+id/splash_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/kp_bg"
        android:clickable="true"
        android:elevation="24dp"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:contentDescription="@string/app_name"
            android:src="@mipmap/ic_launcher_round" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/app_name"
            android:textColor="@color/kp_text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="زخرفة فورية • ثيمات كريستال • ذكاء اصطناعي"
            android:textColor="@color/kp_primary"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
