<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:layoutDirection="rtl"
    android:paddingBottom="104dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="6dp">

        <!-- Quick Setup Card ("لنبدأ — خطوتان فقط") -->
        <LinearLayout
            android:id="@+id/card_quick_setup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_hero"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/setup_card_title"
                    android:src="@drawable/ic_keyboard" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/setup_card_title"
                    android:textColor="@color/kp_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_setup_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_selected"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:text="0 / 2"
                    android:textColor="@color/kp_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/setup_card_subtitle"
                android:textColor="@color/kp_text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_step_enable"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/setup_step_1_btn"
                    android:textColor="@color/kp_on_primary"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_step_select"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/setup_step_2_btn"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Quick Live Test Input -->
        <EditText
            android:id="@+id/et_live_test"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_search_bar"
            android:hint="@string/test_keyboard_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:paddingHorizontal="14dp"
            android:textColor="@color/kp_text_primary"
            android:textColorHint="@color/kp_text_muted"
            android:textSize="13sp" />

        <!-- Search Themes Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_search_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/search_themes_hint"
                android:src="@drawable/ic_search" />

            <EditText
                android:id="@+id/et_theme_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="@string/search_themes_hint"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/kp_text_primary"
                android:textColorHint="@color/kp_text_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 4 Sub-Tabs: الثيمات | برو | ثيماتي | المستخدمين -->
        <LinearLayout
            android:id="@+id/home_sub_tabs"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/subtab_themes"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_selected"
                android:gravity="center"
                android:text="@string/tab_themes"
                android:textColor="@color/kp_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subtab_pro"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_unselected"
                android:gravity="center"
                android:text="@string/tab_pro"
                android:textColor="@color/kp_gold"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subtab_my_themes"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_unselected"
                android:gravity="center"
                android:text="@string/tab_my_themes"
                android:textColor="@color/kp_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subtab_users"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_unselected"
                android:gravity="center"
                android:text="@string/tab_users"
                android:textColor="@color/kp_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Create Custom Theme CTA (shown on My Themes tab) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_create_custom_theme"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="@string/create_theme_btn"
            android:textColor="@color/kp_on_primary"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Categorized Theme Sections Container -->
        <LinearLayout
            android:id="@+id/themes_sections_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
