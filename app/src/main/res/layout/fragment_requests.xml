<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:layoutDirection="rtl"
    android:paddingBottom="104dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="6dp">

        <!-- 2 Sub-Tabs: طلب جديد | طلباتي -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/req_tab_new"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_selected"
                android:gravity="center"
                android:text="@string/req_tab_new"
                android:textColor="@color/kp_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/req_tab_mine"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_unselected"
                android:gravity="center"
                android:text="@string/req_tab_mine"
                android:textColor="@color/kp_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- NEW REQUEST FORM CONTAINER -->
        <LinearLayout
            android:id="@+id/req_form_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <!-- 4 Request Type Buttons (2x2 Grid) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_type_feature"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_selected"
                    android:gravity="center"
                    android:text="✨ طلب ميزة"
                    android:textColor="@color/kp_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_type_bug"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_unselected"
                    android:gravity="center"
                    android:text="🐞 بلاغ مشكلة"
                    android:textColor="@color/kp_text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_type_suggestion"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_unselected"
                    android:gravity="center"
                    android:text="💡 اقتراح"
                    android:textColor="@color/kp_text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_type_instant"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_unselected"
                    android:gravity="center"
                    android:text="⚡ ميزة فورية"
                    android:textColor="@color/kp_text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Form Fields Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">

                <EditText
                    android:id="@+id/et_req_name"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_search_bar"
                    android:hint="@string/req_name_hint"
                    android:importantForAutofill="no"
                    android:inputType="textPersonName"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/kp_text_primary"
                    android:textColorHint="@color/kp_text_muted"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/et_req_title"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_search_bar"
                    android:hint="@string/req_title_hint"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/kp_text_primary"
                    android:textColorHint="@color/kp_text_muted"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/et_req_desc"
                    android:layout_width="match_parent"
                    android:layout_height="128dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_search_bar"
                    android:gravity="top|start"
                    android:hint="@string/req_desc_hint"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLength="2000"
                    android:padding="12dp"
                    android:textColor="@color/kp_text_primary"
                    android:textColorHint="@color/kp_text_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_desc_counter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="end"
                    android:text="0 / 2000"
                    android:textColor="@color/kp_text_muted"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/et_req_contact"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_search_bar"
                    android:hint="@string/req_contact_hint"
                    android:importantForAutofill="no"
                    android:inputType="textEmailAddress"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/kp_text_primary"
                    android:textColorHint="@color/kp_text_muted"
                    android:textSize="13sp" />

                <!-- Optional Image Picker (Zero-permission Android Photo Picker, <= 2MB auto-compressed) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_pick_attachment"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/req_attach_image"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/attachment_preview_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/iv_attachment_preview"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:contentDescription="@string/req_attach_image"
                        android:scaleType="centerCrop" />

                    <TextView
                        android:id="@+id/tv_attachment_info"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="10dp"
                        android:layout_weight="1"
                        android:textColor="@color/kp_success"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/btn_remove_attachment"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:text="إزالة ✕"
                        android:textColor="@color/kp_danger"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Expandable Device Info Preview -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:id="@+id/btn_toggle_device_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/req_device_info"
                        android:textColor="@color/kp_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_device_info_arrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="عرض ▼"
                        android:textColor="@color/kp_primary"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_device_info_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="monospace"
                    android:textColor="@color/kp_text_secondary"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Privacy Notice -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_search_bar"
                android:padding="12dp"
                android:text="@string/req_privacy_note"
                android:textColor="@color/kp_text_secondary"
                android:textSize="11sp" />

            <!-- Submit Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_submit_request"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:text="@string/req_submit_btn"
                android:textColor="@color/kp_on_primary"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- MY REQUESTS HISTORY CONTAINER -->
        <LinearLayout
            android:id="@+id/req_mine_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:visibility="gone" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
