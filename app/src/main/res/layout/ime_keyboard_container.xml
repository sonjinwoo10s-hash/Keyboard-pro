<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ime_root_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0D1119"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <!-- Top Smart Toolbar -->
    <LinearLayout
        android:id="@+id/ime_toolbar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#121826"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp">

        <TextView
            android:id="@+id/btn_ime_decorate"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/bg_chip_unselected"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="✨ زخرفة"
            android:textColor="@color/kp_text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_ime_ai"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/bg_chip_unselected"
            android:gravity="center"
            android:paddingHorizontal="9dp"
            android:text="🤖 AI"
            android:textColor="@color/kp_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_ime_clipboard"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/bg_chip_unselected"
            android:gravity="center"
            android:paddingHorizontal="9dp"
            android:text="📋"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_ime_vault"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/bg_chip_unselected"
            android:gravity="center"
            android:paddingHorizontal="9dp"
            android:text="🔐"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_ime_emoji"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/bg_chip_unselected"
            android:gravity="center"
            android:paddingHorizontal="9dp"
            android:text="😊"
            android:textSize="13sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btn_ime_settings"
            android:layout_width="34dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_chip_unselected"
            android:gravity="center"
            android:text="⚙"
            android:textColor="@color/kp_text_secondary"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Horizontal Live Text Decoration / Multi-Font Switcher Strip -->
    <HorizontalScrollView
        android:id="@+id/ime_style_strip_scroll"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="#0F1522"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/ime_style_strip_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp" />
    </HorizontalScrollView>

    <!-- AI Quick Actions Inline Bar -->
    <LinearLayout
        android:id="@+id/ime_ai_bar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="#101A2D"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/btn_ai_proofread"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_selected"
            android:gravity="center"
            android:text="@string/ime_ai_proofread"
            android:textColor="@color/kp_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_ai_rewrite"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_selected"
            android:gravity="center"
            android:text="@string/ime_ai_rewrite"
            android:textColor="@color/kp_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_ai_translate"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_selected"
            android:gravity="center"
            android:text="@string/ime_ai_translate"
            android:textColor="@color/kp_primary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Smart Suggestions Strip -->
    <HorizontalScrollView
        android:id="@+id/ime_suggestions_scroll"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:background="#0E131E"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/ime_suggestions_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp" />
    </HorizontalScrollView>

    <!-- Inline Secondary Panel (Emoji / Clipboard / Keyboard Pass Vault / Stickers) -->
    <ScrollView
        android:id="@+id/ime_inline_panel_scroll"
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:background="#0F141F"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/ime_inline_panel_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp" />
    </ScrollView>

    <!-- Main Custom Canvas Keyboard View (Full-Width, Strict No-Split) -->
    <com.keyboardpro.ime.ProKeyboardView
        android:id="@+id/ime_keyboard_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
